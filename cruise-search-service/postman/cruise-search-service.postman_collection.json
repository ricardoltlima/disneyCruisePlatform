            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"shipName\": \"Disney Wish\",\n  \"departurePort\": \"Port Canaveral\",\n  \"destination\": \"Bahamas\",\n  \"departureDate\": \"{{departureDate}}\",\n  \"returnDate\": \"{{returnDate}}\",\n  \"availableCabins\": 25,\n  \"basePrice\": 1499.99,\n  \"status\": \"AVAILABLE\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/cruises",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "cruises"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 403 Forbidden', function () {",
              "  pm.response.to.have.status(403);",
              "});",
              "",
              "pm.test('response has friendly forbidden error', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.code).to.eql('FORBIDDEN');",
              "  pm.expect(json.message).to.eql('You do not have permission to perform this action.');",
              "  pm.expect(json).to.have.property('timestamp');",
              "});"
            ]
          }
        }
      ]
    },
    {
