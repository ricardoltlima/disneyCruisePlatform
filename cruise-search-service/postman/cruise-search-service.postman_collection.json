        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/cruises/{{cruiseId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "cruises",
            "{{cruiseId}}"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('cruiseId is configured', function () {",
              "  pm.expect(pm.environment.get('cruiseId')).to.not.be.oneOf([undefined, null, '', 'replace-with-created-cruise-id']);",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200 OK', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('response has cruise fields', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('shipName');",
              "  pm.expect(json).to.have.property('departurePort');",
              "  pm.expect(json).to.have.property('destination');",
              "  pm.expect(json).to.have.property('departureDate');",
              "  pm.expect(json).to.have.property('returnDate');",
              "  pm.expect(json).to.have.property('availableCabins');",
              "  pm.expect(json).to.have.property('basePrice');",
              "  pm.expect(json).to.have.property('status');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Cruises",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{customerToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/cruises?page={{page}}&size={{size}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "cruises"
          ],
          "query": [
            {
              "key": "page",
              "value": "{{page}}"
            },
            {
              "key": "size",
              "value": "{{size}}"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200 OK', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('response is an array', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.be.an('array');",
              "});",
              "",
              "pm.test('cruises have expected shape when present', function () {",
              "  const json = pm.response.json();",
              "  if (json.length > 0) {",
              "    pm.expect(json[0]).to.have.property('id');",
              "    pm.expect(json[0]).to.have.property('shipName');",
              "    pm.expect(json[0]).to.have.property('departurePort');",
              "    pm.expect(json[0]).to.have.property('destination');",
              "    pm.expect(json[0]).to.have.property('departureDate');",
              "    pm.expect(json[0]).to.have.property('returnDate');",
              "    pm.expect(json[0]).to.have.property('availableCabins');",
              "    pm.expect(json[0]).to.have.property('basePrice');",
              "    pm.expect(json[0]).to.have.property('status');",
              "  }",
              "});"
            ]
          }
        }
      ]
    },
